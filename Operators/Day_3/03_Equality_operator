module test;

  logic [3:0] a, b;

  initial begin

    a = 4'b1010;
    b = 4'b1010;

    $display("a == b  = %0b", a == b);
    $display("a != b  = %0b", a != b);
    $display("a === b = %0b", a === b);
    $display("a !== b = %0b", a !== b);

    a = 4'b10x0;
    b = 4'b10x0;

    $display("With X:");
    $display("a == b  = %0b", a == b);
    $display("a === b = %0b", a === b);

  end

endmodule
